    "New and resumed Claude sessions get Pencil's MCP server (as “pencil-desktop”, via --mcp-config), connected to the Pencil desktop app instead of the VS Code extension. Your global Claude configuration is not changed. Already running sessions need a restart.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni ve devam ettirilen Claude oturumları Pencil'ın MCP sunucusunu (“pencil-desktop” adıyla, --mcp-config ile) alır; VS Code eklentisi yerine Pencil masaüstü uygulamasına bağlanır. Genel Claude yapılandırmanız değişmez. Çalışan oturumların yeniden başlatılması gerekir."
          }
        }
      }
    },
