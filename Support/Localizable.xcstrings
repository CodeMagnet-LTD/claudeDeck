    ", Claude sessions working right now: %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ", şu an çalışan Claude oturumu: %lld"
          }
        }
      }
    },
    ". Quitting closes them all (Claude sessions resume where they left off next launch). Keep running in the background to close the window while everything keeps working.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ". Çıkış hepsini kapatır (Claude oturumları bir sonraki açılışta kaldığı yerden devam eder). Arka planda çalışmaya devam et dersen pencere kapanır, her şey çalışmayı sürdürür."
          }
        }
      }
    },
    "A scheduled run found later than this (Mac asleep, ClaudeDeck not running) is skipped.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu süreden daha geç fark edilen zamanlanmış çalıştırma (Mac uykudaysa, ClaudeDeck açık değilse) atlanır."
          }
        }
      }
    },
