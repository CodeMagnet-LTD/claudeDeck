    "\"%@\" in ~/.claude/settings.json has an unexpected format; left untouched.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.claude/settings.json içindeki \"%@\" beklenmeyen biçimde; dokunulmadı."
