    ", Claude sessions working right now: %lld": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ", şu an çalışan Claude oturumu: %lld"
          }
        }
      }
    },
    ". Quitting closes them all (Claude sessions resume where they left off next launch). Keep running in the background to close the window while everything keeps working.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ". Çıkış hepsini kapatır (Claude oturumları bir sonraki açılışta kaldığı yerden devam eder). Arka planda çalışmaya devam et dersen pencere kapanır, her şey çalışmayı sürdürür."
          }
        }
      }
    },
    "5-hour usage %@": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 saatlik kullanım %@"
          }
        }
      }
    },
    "5h": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "5 sa"
          }
        }
      }
    },
    "A branch named “%@” already exists.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” adlı bir dal zaten var."
          }
        }
      }
    },
    "A folder can’t be moved into itself.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir klasör kendi içine taşınamaz."
          }
        }
      }
    },
    "A scheduled run found later than this (Mac asleep, ClaudeDeck not running) is skipped.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu süreden daha geç fark edilen zamanlanmış çalıştırma (Mac uykudaysa, ClaudeDeck açık değilse) atlanır."
          }
        }
      }
    },
    "A session that stopped on the Claude plan's usage limit gets this message once, when the limit resets.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude planının kullanım limitinde duran bir oturuma, limit sıfırlandığında bu mesaj bir kez gönderilir."
          }
        }
      }
    },
    "A skill with this name already exists there.": {
